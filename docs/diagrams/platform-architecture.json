  "cards": [
    {
      "dot": "cyan",
      "title": "五个控制面角色",
      "items": [
        "API Server 只管理对象和授权，不调用规划器或插件",
        "PostgreSQL 是正确性来源，通知只降低延迟",
        "Scheduler 只做 placement/allocation，无外部副作用",
        "Controller reconcile spec/status，并创建确定性 Operation",
        "Executor 执行一次性 Operation，保存真实外部结果"
      ]
    },
    {
      "dot": "emerald",
      "title": "对象驱动路径",
      "items": [
        "Environment.spec → Placement → PlanRevision → Operation",
        "Operation → Resource Framework → 外部平台 → Resource.status",
        "Environment.status/conditions 由 Controller 根据事实更新",
        "finalizer 在 Unknown 或未释放 Allocation 时保持"
      ]
    }
  ]
