  "title":"TaskView",
  "allOf":[{"$ref":"definitions.json#/$defs/envelope"},{"type":"object","properties":{
    "kind":{"const":"TaskView"},"metadata":{"$ref":"definitions.json#/$defs/metadataWithGeneration"},
