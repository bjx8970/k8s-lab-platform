{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://k8s-lab-platform.example/schemas/control-plane/definitions.json",
  "title":"K8s Lab Platform control-plane shared definitions",
  "$defs":{
    "uuid":{"type":"string","format":"uuid","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "domainId":{"type":"string","minLength":1,"maxLength":255,"description":"External identity scope such as a PVE or OpenWrt domain; a business string, not necessarily a UUID."},
    "nonEmptyString":{"type":"string","minLength":1},
    "timestamp":{"type":"string","format":"date-time"},
    "resourceVersion":{"type":"string","pattern":"^[1-9][0-9]*$","description":"Server-assigned PostgreSQL version; every persisted write increments it."},
    "generation":{"type":"integer","minimum":1,"description":"Increments only when semantic spec changes."},
    "observedGeneration":{"type":"integer","minimum":0,"description":"Controller-completed generation; repository also enforces observedGeneration <= metadata.generation."},
    "metadata":{"type":"object","required":["uid","name","resourceVersion"],"properties":{"uid":{"$ref":"#/$defs/uuid"},"name":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]{0,62}$"},"resourceVersion":{"$ref":"#/$defs/resourceVersion"},"creationTimestamp":{"$ref":"#/$defs/timestamp"},"deletionTimestamp":{"type":["string","null"],"format":"date-time","description":"Set by DELETE; never represented by desiredState."},"finalizers":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"labels":{"type":"object","additionalProperties":{"type":"string"}},"annotations":{"type":"object","additionalProperties":{"type":"string"}}}},
    "metadataWithGeneration":{"allOf":[{"$ref":"#/$defs/metadata"},{"type":"object","required":["generation"],"properties":{"generation":{"$ref":"#/$defs/generation"}}}],"unevaluatedProperties":false},
    "envelope":{"type":"object","required":["apiVersion","kind","metadata","spec","status"],"properties":{"apiVersion":{"const":"lab.platform/v1"},"kind":{"type":"string","minLength":1},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object"},"status":{"type":"object"}}},
    "objectRef":{"type":"object","required":["uid"],"properties":{"uid":{"$ref":"#/$defs/uuid"},"name":{"$ref":"#/$defs/nonEmptyString"}},"unevaluatedProperties":false},
    "templateRef":{"type":"object","required":["name","version"],"properties":{"name":{"$ref":"#/$defs/nonEmptyString"},"version":{"$ref":"#/$defs/nonEmptyString"}},"unevaluatedProperties":false},
    "profileRef":{"type":"object","required":["name","revision"],"properties":{"name":{"$ref":"#/$defs/nonEmptyString"},"revision":{"type":"integer","minimum":1}},"unevaluatedProperties":false},
    "condition":{"type":"object","required":["type","status"],"properties":{"type":{"type":"string","minLength":1},"status":{"enum":["True","False","Unknown"]},"reason":{"$ref":"#/$defs/nonEmptyString"},"message":{"type":"string"},"transitionTime":{"$ref":"#/$defs/timestamp"}},"unevaluatedProperties":false},
    "conditions":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/condition"},"x-uniqueBy":"type","$comment":"uniqueItems alone checks object identity, not type uniqueness. The x-uniqueBy extension declares the semantic intent; repository and DDL enforce it."},
    "error":{"type":"object","required":["code","message"],"properties":{"code":{"$ref":"#/$defs/nonEmptyString"},"message":{"type":"string","minLength":1},"providerCode":{"$ref":"#/$defs/nonEmptyString"},"details":{"type":"object","additionalProperties":true}},"unevaluatedProperties":false},
    "digest":{"type":"string","pattern":"^(sha256:)?[0-9a-fA-F]{64}$"},
    "arbitraryObject":{"type":"object","additionalProperties":true},
    "externalIdentity":{"type":"object","required":["externalKey"],"properties":{"externalKey":{"$ref":"#/$defs/nonEmptyString"},"locator":{"type":"object","additionalProperties":true}},"unevaluatedProperties":false},
    "externalTaskRef":{"oneOf":[{"$ref":"#/$defs/nonEmptyString"},{"type":"object","required":["id"],"properties":{"id":{"$ref":"#/$defs/nonEmptyString"},"provider":{"$ref":"#/$defs/nonEmptyString"},"kind":{"$ref":"#/$defs/nonEmptyString"},"statusRef":{"$ref":"#/$defs/nonEmptyString"},"exitCodeRef":{"$ref":"#/$defs/nonEmptyString"},"logRef":{"$ref":"#/$defs/nonEmptyString"}},"unevaluatedProperties":false}]},
    "lease":{"type":"object","required":["owner","until"],"properties":{"owner":{"$ref":"#/$defs/nonEmptyString"},"until":{"$ref":"#/$defs/timestamp"}},"unevaluatedProperties":false},
    "resourceIntent":{"type":"object","required":["logicalKey","type","driverId","lifecycle","cleanupResponsibility"],"properties":{"logicalKey":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9._-]{0,127}$"},"type":{"$ref":"#/$defs/nonEmptyString"},"driverId":{"$ref":"#/$defs/nonEmptyString"},"connectionRef":{"oneOf":[{"$ref":"#/$defs/uuid"},{"$ref":"#/$defs/nonEmptyString"}]},"lifecycle":{"enum":["created","adopted"]},"cleanupResponsibility":{"enum":["delete","unregister","retain"]},"externalIdentity":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/externalIdentity"}]}},"unevaluatedProperties":false},
    "planItem":{"type":"object","required":["itemKey","kind","dependsOn"],"properties":{"itemKey":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9._/-]{0,127}$"},"kind":{"enum":["resource.create","resource.register","resource.action","wait.observation","wait.endpoint","condition.set"]},"dependsOn":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"resourceKey":{"type":"string","minLength":1},"action":{"$ref":"#/$defs/nonEmptyString"},"input":{"$ref":"#/$defs/arbitraryObject"},"request":{"$ref":"#/$defs/arbitraryObject"},"skipIfObservation":{"type":"object","required":["field","equals","maxAgeSeconds"],"properties":{"field":{"$ref":"#/$defs/nonEmptyString"},"equals":{},"maxAgeSeconds":{"type":"integer","minimum":0}},"unevaluatedProperties":false},"condition":{"$ref":"#/$defs/arbitraryObject"}},"unevaluatedProperties":false},
    "cleanupItem":{"type":"object","required":["resourceKey","responsibility"],"properties":{"resourceKey":{"$ref":"#/$defs/nonEmptyString"},"responsibility":{"enum":["delete","unregister","retain"]},"action":{"enum":["delete","unregister","retain"]}},"unevaluatedProperties":false},
    "targetSnapshot":{"type":"object","required":["resourceId","bindingId","bindingRevision","domainId","connectionId","connectionRevision","secretVersionRef","pluginId","pluginVersion","driverId"],"properties":{"resourceId":{"$ref":"#/$defs/uuid"},"bindingId":{"$ref":"#/$defs/uuid"},"bindingRevision":{"type":"integer","minimum":1},"domainId":{"$ref":"#/$defs/domainId"},"connectionId":{"$ref":"#/$defs/uuid"},"connectionRevision":{"type":"integer","minimum":1},"secretVersionRef":{"$ref":"#/$defs/nonEmptyString"},"pluginId":{"$ref":"#/$defs/nonEmptyString"},"pluginVersion":{"$ref":"#/$defs/nonEmptyString"},"driverId":{"$ref":"#/$defs/nonEmptyString"},"externalIdentity":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/externalIdentity"}]},"locator":{"type":"object","additionalProperties":true}},"unevaluatedProperties":false,"$comment":"Constructed by Operation admission from verified Resource/Binding/Connection rows. Callers must not supply it as free-form JSON."},
    "accessEndpoint":{"type":"object","required":["kind","label","resourceId","host","port","username"],"properties":{"kind":{"const":"ssh"},"label":{"$ref":"#/$defs/nonEmptyString"},"resourceId":{"$ref":"#/$defs/uuid"},"host":{"$ref":"#/$defs/nonEmptyString"},"port":{"type":"integer","minimum":1,"maximum":65535},"username":{"$ref":"#/$defs/nonEmptyString"}},"unevaluatedProperties":false}
  }
}
